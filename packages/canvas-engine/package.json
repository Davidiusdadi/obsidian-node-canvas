{
  "name": "canvas-engine",
  "version": "1.0.0",
  "main": "dist/lib.js",
  "module": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "license": "private",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --loader:.ts=ts --platform=node \"--external:@babel/preset-typescript/*\" --external:node-pty --outfile=build/main.js --sourcemap",
    "dev": "this_workspace=`pwd`; pnpm build && cd ../.. && node \"$this_workspace\"/build/main.js",
    "dev:inspect": "this_workspace=`pwd`; pnpm build && cd ../.. && node --inspect \"$this_workspace\"/build/main.js",
    "dev:inspect-brk": "this_workspace=`pwd`; pnpm build && cd ../.. && node --inspect-brk  \"$this_workspace\"/build/main.js",
    "build:tsc": "tsc",
    "build:lib": "esbuild src/lib.ts --bundle --loader:.ts=ts --platform=node \"--external:@babel/preset-typescript/*\" --outfile=dist/lib.js --sourcemap && tsc --emitDeclarationOnly"
  },
  "dependencies": {
    "@langchain/community": "^1.1.15",
    "@langchain/ollama": "^1.2.2",
    "@langchain/openai": "^1.2.7",
    "axios": "^1.13.5",
    "canvas": "^3.2.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "flatted": "^3.3.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.0.0",
    "lodash": "^4.17.23",
    "nunjucks": "^3.2.4",
    "openai": "^6.21.0",
    "remark-parse": "^11.0.0",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.2",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.0",
    "@trbn/jsoncanvas": "^1.0.6",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.2.3",
    "@types/nunjucks": "^3.2.6",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.3"
  }
}
